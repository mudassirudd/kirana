{
  "compilerOptions": {
    //language and environment
    "lib": ["ES2022"],
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    //strictness
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": false,
    //compatibility
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    //performance
    "skipLibCheck": true,
    // build
    "outDir": "./dist"

  },

  "exclude": [
    "node_modules", "dist"
  ]
}