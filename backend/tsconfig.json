{
  "compilerOptions": {
    //language and environment
    "lib": ["ES2022"],
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    //strictness
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": false,
    //compatibility
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    //performance
    "skipLibCheck": true,

  },

  "exclude": [
    "node_modules"
  ]
}